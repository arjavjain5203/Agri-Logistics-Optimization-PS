# ============================================================
# KISAN GUARD — Market Intelligence Agent
# Environment Variables
# ============================================================

# --- Required ---
# Gemini API Key (shared with Crop Agent)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional: Market Data Provider ---
# Override the AgMarket-API base URL (default: https://agmarknet-api.onrender.com)
# AGMARKET_API_BASE_URL=https://agmarknet-api.onrender.com

# --- Optional: Observability (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=kisan-guard

# --- Optional: Crop Agent Keys (if running end-to-end) ---
OPENWEATHER_API_KEY=your_openweather_api_key_here
